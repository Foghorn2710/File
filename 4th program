#include <stdio.h>

int a[10][10], vis[10], stack[10], n, top = -1;

void dfs(int u) {
    vis[u] = 1;
    for (int v = 0; v < n; v++) {
        if (a[u][v] == 1 && !vis[v]) 
            dfs(v);
    }
    stack[++top] = u; // Push to stack when done
}

int main() {
    printf("Enter n: ");
    scanf("%d", &n);

    printf("Enter matrix:\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    for (int i = 0; i < n; i++) 
        if (!vis[i]) dfs(i);

    printf("Topological Order: ");
    for (int i = top; i >= 0; i--) 
        printf("%d ", stack[i]);

    return 0;
}
