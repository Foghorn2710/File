#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void quick(int a[], int first, int last) {
    int i, j, pivot, temp;

    if (first < last) {
        pivot = first;
        i = first;
        j = last;

        while (i < j) {
            while (a[i] <= a[pivot] && i < last) i++;
            while (a[j] > a[pivot]) j--;
            if (i < j) {
                temp = a[i]; a[i] = a[j]; a[j] = temp;
            }
        }

        temp = a[pivot]; a[pivot] = a[j]; a[j] = temp;
        
        quick(a, first, j - 1);
        quick(a, j + 1, last);
    }
}

int main() {
    int n;
    printf("Enter the element(n>5000): ");
    scanf("%d", &n);

    int *a = malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) a[i] = rand() % 1000;

    clock_t start = clock();
    quick(a, 0, n - 1);
    clock_t end = clock();

    printf("Time taken to sort the element(n>5000): %f\n", (double)(end - start) / CLOCKS_PER_SEC);
    return 0;
}
